# SASSAFRAS personal dashboard — rootful Podman Quadlet unit.
#
# Install:  sudo cp quadlet/vista-sassafras.container /etc/containers/systemd/
#           sudo systemctl daemon-reload && sudo systemctl start vista-sassafras.service
# Edit:     change the file in /etc/containers/systemd/, then
#           sudo systemctl daemon-reload && sudo systemctl restart vista-sassafras.service
#
# Reached at https://sassafras.vistardg.com (Caddy -> 127.0.0.1:8094).
#
# Supersedes vista-glance.service, the homelab server-stats Glance that ran on
# 8093 / glance.vistardg.com. Its Homelab page was folded in here as a second
# tab on 2026-08-06 and that unit was retired.
#
# Network=host, for the same reason vista-glance needed it: the Homelab tab's
# widgets read the kiosk status feeds on the host's loopback (8080 host, 8081
# media, 8082 fridge, 8084 LAN), and those pollers bind 127.0.0.1 ONLY. On a
# bridge network they are unreachable by every route — host.containers.internal
# (10.88.0.1) and the LAN address both get connection-refused, because the
# listener is not on those interfaces at all.
#
# The loopback-only posture is UNCHANGED by this. Under Network=host the bind
# is governed by `server.host` in config/glance.yml, which is set to 127.0.0.1
# — so this still listens on loopback only, still has no firewalld port, and
# still has no LAN-direct access. Caddy and the Cloudflare tunnel remain the
# only ways in, and both already target 127.0.0.1:8094. Same posture as
# vista-mealie, arrived at differently.
#
# If server.host is ever set back to 0.0.0.0, this becomes LAN-reachable on
# :8094 immediately, with no firewalld change to warn you. The two settings
# move together.
#
# Config + assets are bind-mounted read-only from the git clone at
# /srv/vista-rdg/apps/sassafras (repo: github.com/toyo7m/my-glance-dashboard).
# Deploying a config change is `git pull` + `systemctl restart` — no image
# rebuild, matching how vista-glance is run.
#
# The image entrypoint hardcodes --config /app/config/glance.yml, so the config
# mount target must be /app/config.

[Unit]
Description=SASSAFRAS personal dashboard (Glance, loopback 127.0.0.1:8094, via Caddy)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/glanceapp/glance:v0.8.5
ContainerName=vista-sassafras

# See the header: required to reach the loopback-bound status feeds. The bind
# address is config/glance.yml's `server.host: 127.0.0.1`, not a PublishPort.
Network=host

Volume=/srv/vista-rdg/apps/sassafras/config:/app/config:ro,Z
Volume=/srv/vista-rdg/apps/sassafras/assets:/app/assets:ro,Z

# AUTH_SECRET_KEY, AUTH_PASSWORD_HASH, WORKER_URL, DASHBOARD_KEY.
# Root-only 0600, never in the repo.
EnvironmentFile=/etc/vista-rdg/sassafras.env

# Clock widget and RSS timestamps render Eastern rather than the container's UTC.
Environment=TZ=America/New_York

ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true

HealthCmd=CMD-SHELL wget -q -O /dev/null http://127.0.0.1:8094/ || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
